# Rust
/target
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
*.so
*.pyd
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test data (fetched via scripts/fetch_test_data.sh)
/data/

# OS / editor
.DS_Store

# Run cache (content-addressed store + SQLite metadata)
/.ligase/

# Nextra docs site (web/)
/web/node_modules/
# Regenerated by `next build`; Next's own template tells you not to edit it.
/web/next-env.d.ts
/web/tsconfig.tsbuildinfo
/web/.next/
/web/out/
# Generated on every docs build from the package itself, the way mkdocstrings
# generated the old API reference: nothing here is edited by hand, and a
# committed copy could only ever be stale.
/web/content/reference/api/
/web/content/reference/cli.mdx
/web/content/notebooks/
/web/lib/diagnostics.generated.ts
/web/lib/quickstart.generated.ts
/web/lib/ranked.generated.ts
